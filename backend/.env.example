# CapyPad backend environment template
# Fill all placeholders before running in production.

# Quarkus / HTTP
QUARKUS_HTTP_PORT=<backend-port>
QUARKUS_HTTP_CORS=<true-or-false>
QUARKUS_HTTP_CORS_ORIGINS=<comma-separated-frontend-origins>
QUARKUS_HTTP_CORS_METHODS=<comma-separated-http-methods>
QUARKUS_HTTP_CORS_HEADERS=<comma-separated-http-headers>
QUARKUS_DATASOURCE_DB_KIND=postgresql
QUARKUS_DATASOURCE_JDBC_URL=<jdbc-url>
QUARKUS_HIBERNATE_ORM_DATABASE_GENERATION=<update-or-validate>

# PostgreSQL
POSTGRES_USER=<postgres-username>
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=<postgres-database-name>
KC_DB_USERNAME=<keycloak-db-username>
KC_DB_PASSWORD=<keycloak-db-password>

# Keycloak
KEYCLOAK_ADMIN=<keycloak-admin-username>
KEYCLOAK_ADMIN_PASSWORD=<keycloak-admin-password>
KEYCLOAK_URL=<internal-keycloak-url>
KEYCLOAK_CLIENT_SECRET=<keycloak-client-secret>

# Auth / OIDC URLs
CAPYPAD_FRONTEND_URL=<public-frontend-url>
CAPYPAD_AUTH_CALLBACK_URL=<public-backend-callback-url>
CAPYPAD_KEYCLOAK_EXTERNAL_URL=<public-keycloak-url>
CAPYPAD_OIDC_TOKEN_ISSUER=<oidc-issuer-url>

# Auth / OIDC behavior
CAPYPAD_OIDC_CONNECTION_DELAY=<duration>
CAPYPAD_OIDC_LOG_LEVEL=<INFO-or-DEBUG>
CAPYPAD_JWT_LOG_LEVEL=<INFO-or-DEBUG>
CAPYPAD_AUTH_COOKIE_SECURE=<true-or-false>
CAPYPAD_AUTH_COOKIE_SAME_SITE=<Lax-Strict-or-None>

# App settings
CAPYPAD_CLEANUP_MAX_AGE_DAYS=<integer-days>
CAPYPAD_CLEANUP_INTERVAL=<duration>
BLOCK_IMAGE=<true-or-false>
MAINTENANCE_MODE=<true-or-false>
